    {
        "id": "10aa175bc4800986",
        "type": "function",
        "z": "9337e17f366e7aec",
        "name": "CALCULAR",
        "func": "let a = Number(flow.get(\"valor1\"));\nlet b = Number(flow.get(\"valor2\"));\nlet resultado;\n\nswitch (msg.topic) {\n    case \"suma\":\n        resultado = a + b;\n        break;\n    case \"resta\":\n        resultado = a - b;\n        break;\n    case \"multiplicación\":\n        resultado = a * b;\n        break;\n    case \"división\":\n        resultado = b !== 0 ? a / b : \"Error: división por cero\";\n        break;\n    default:\n        resultado = \"Operación no válida\";\n}\n\nmsg.payload = resultado;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 180,
        "wires": [
